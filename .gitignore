# Godot editor cache
.godot/
*.translation

# Original game assets — copyrighted, supplied locally, never committed.
# See LICENSE. The FOLDER SKELETON is committed (each .gitkeep says what
# belongs in it) so a fresh clone shows where the art goes; git will not
# descend into a wholly-ignored directory, which is why each level is
# re-included before its contents are excluded again.
assets_original/*
!assets_original/gog/
assets_original/gog/*
!assets_original/gog/.gitkeep
!assets_original/zod/
assets_original/zod/*
!assets_original/zod/.gitkeep

# Built from assets_original/ by tools/setup_assets.py.
project/assets/*
!project/assets/.gitkeep


# Scraped/downloaded raw data
tools/scrape/data/*.zip

# OS
.DS_Store
Thumbs.db

__pycache__/
*.pyc

# GOG installer (copyrighted, never committed)
setup_*.exe

# Release builds — self-contained binaries that EMBED the original
# copyrighted art. Never commit or publish these.
build/

# dev screenshot helper output
project/screenshot_*.png
project/screenshot_*.png.import

# zcode session data
.zcode/
